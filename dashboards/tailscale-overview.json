    {
      "id": 25,
      "title": "Oldest collector cycle",
      "description": "Age of the oldest completed collection cycle. Unreachable collectors show 300 seconds; yellow starts at 90 seconds and red at 180 seconds.",
      "type": "gauge",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max((time() - homelab_monitor_last_run_timestamp_seconds{job=\"${job}\"}) or on(instance, job) ((up{job=\"${job}\"} == 0) * 300)) or vector(300)",
          "instant": true,
          "range": false,
          "legendFormat": "Oldest collector cycle"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          },
          "unit": "s",
          "decimals": 0,
          "min": 0,
          "noValue": "No data",
          "mappings": [],
          "max": 300
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
