{
  "uid": "tailscale-monitoring",
  "title": "Tailscale Monitoring",
  "tags": [
    "tailscale",
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 20,
      "title": "Dependencies healthy",
      "description": "Passing checks / configured expected checks. Missing metrics count against the total. Set the expected total across all collectors.",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(max by(host, check) (homelab_dependency_up{job=\"${job}\"}) == bool 1) or vector(0)) / ${expected_checks} unless on() vector(${expected_checks}) == 0",
          "instant": true,
          "range": false,
          "legendFormat": "Dependencies healthy"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "noValue": "No data",
          "mappings": [],
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 21,
      "title": "Resources healthy",
      "description": "Healthy percentage against the configurable expected total. Zero expected disables this summary. Resources are deduplicated across collectors by node; hosts by host label.",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(max by(node) (homelab_tailnet_node_online{job=\"${job}\"}) == bool 1) or vector(0)) / ${expected_nodes} unless on() vector(${expected_nodes}) == 0",
          "instant": true,
          "range": false,
          "legendFormat": "Resources healthy"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.001
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "noValue": "No data",
          "mappings": [],
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      }
    },
